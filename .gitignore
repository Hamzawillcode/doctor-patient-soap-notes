!outputs/sample_consultation_roles.json
!outputs/sample_consultation_2*.json
!outputs/sample_consultation_clinical_entities.json
!outputs/example_transcript_clinical_entities.json
!outputs/biobert_maccrobat_training_metrics.json

!outputs/*_soap_facts.json
!outputs/*_soap_note.json
!outputs/*_soap_note.md
!outputs/example_transcript_2_clinical_entities.json

